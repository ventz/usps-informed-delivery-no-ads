# USPS Informed Delivery cleaner — copy to .env and fill in.
# .env is gitignored; nothing here is baked into the code.

OPENAI_API_KEY=sk-proj-REPLACE-ME
OPENAI_MODEL=gpt-5.6-sol

# Local AWS credentials profile + region (SES receiving is region-scoped)
AWS_PROFILE=AWSProfileName
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Raw forwarded Informed Delivery emails land here via SES (90-day expiry)
APP_BUCKET_NAME=usps-ai-email-123456789012
# The address you forward digests to. It has no mailbox — SES writes straight to S3.
SES_RECIPIENT=usps@domainViaSES.tld

# Output is EMAIL ONLY — no S3 output bucket, no website.
DIGEST_TO=you@yourmail.tld
DIGEST_FROM=no-reply@domainViaSES.tld

# Optional. Comma-separated address(es) allowed to forward digests to
# SES_RECIPIENT. Anyone who learns that address can otherwise inject a fully
# attacker-authored "digest" that gets mailed onward from DIGEST_FROM as a
# trusted email. Leave unset to accept anything (fine locally, weaker in prod).
# ALLOWED_FORWARDERS=you@yourmail.tld
