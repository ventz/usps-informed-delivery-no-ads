# USPS Informed Delivery cleaner — copy to .env and fill in.
# .env is gitignored; nothing here is baked into the code.

OPENAI_API_KEY=sk-proj-REPLACE-ME
OPENAI_MODEL=gpt-5.6-sol

# Local AWS credentials profile + region (SES receiving is region-scoped)
AWS_PROFILE=AWSProfileName
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Raw forwarded Informed Delivery emails land here via SES (1-year expiry)
APP_BUCKET_NAME=usps-ai-email-123456789012
# The address you forward digests to. It has no mailbox — SES writes straight to S3.
SES_RECIPIENT=usps@domainViaSES.tld

# Output is EMAIL ONLY — no S3 output bucket, no website.
DIGEST_TO=you@yourmail.tld
DIGEST_FROM=no-reply@domainViaSES.tld

# Who is allowed to forward digests to SES_RECIPIENT. Anyone who learns that
# address can otherwise inject a fully attacker-authored "digest" that gets
# mailed onward from DIGEST_FROM as a trusted, unattended email.
#
# Defaults to DIGEST_TO when unset, which is right when you forward from the
# same mailbox the clean digest comes back to. Set it when the forwarding
# address differs — but note that an explicit list REPLACES that default rather
# than extending it, so include DIGEST_TO yourself if you also forward by hand
# from it. Comma-separated, case-insensitive; each entry is either a
# full address (matched exactly) or a bare "@customdomain.tld" (matched against
# the domain and its subdomains):
#
#   ALLOWED_FORWARDERS=youremail@gmail.com,@customdomain.tld
#
# That example covers the common split setup: you forward some digests by hand
# from Gmail, and a filter on youremail@customdomain.tld auto-forwards the rest.
# Gmail's auto-forward does NOT send as your own address — it rewrites the
# envelope sender to youremail+caf_=usps=domainviases.tld@customdomain.tld. The
# +tag is stripped before matching, so youremail@customdomain.tld would also
# work here; the domain entry is just broader.
#
# Set to "*" ALONE to disable the check and accept anything (fine locally, unsafe in
# production). A value that is blank or only commas is a hard startup error, not a
# silent disable — turning the gate off has to be deliberate.
# ALLOWED_FORWARDERS=youremail@gmail.com,@customdomain.tld
