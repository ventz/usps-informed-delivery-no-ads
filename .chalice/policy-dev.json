{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/usps-*"
    },
    {
      "Sid": "ReadInboundEmailObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::usps-ai-email-*/*"
    },
    {
      "Sid": "SendTheRebuiltDigest",
      "Effect": "Allow",
      "Action": [
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:*:*:identity/*"
    }
  ]
}
